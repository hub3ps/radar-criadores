# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
# Service role — o processo é backend e escreve em todas as tabelas.
SUPABASE_SERVICE_ROLE_KEY=
# O schema precisa estar em Settings → API → Exposed schemas.
SUPABASE_SCHEMA=radar

# ---------------------------------------------------------------------------
# OpenRouter (scorer)
# A API do OpenRouter e compativel com a da OpenAI, nao com a da Anthropic:
# o modelo vai no formato fornecedor/modelo.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# none | low | medium | high. `none` nao manda o parametro de raciocinio:
# mais barato e menos coisa para o roteamento recusar.
OPENROUTER_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# Evolution API (v2)
# ---------------------------------------------------------------------------
EVOLUTION_BASE_URL=https://evolution.seudominio.com
EVOLUTION_INSTANCE=radar
EVOLUTION_API_KEY=
# Segredo do webhook. Configure na Evolution a URL:
#   https://seu-radar.easypanel.host/webhook/evolution/<este-token>
EVOLUTION_WEBHOOK_TOKEN=troque-por-um-segredo-longo

# ---------------------------------------------------------------------------
# Apify (Instagram e TikTok)
# Sem APIFY_TOKEN, os coletores sociais logam aviso e devolvem vazio.
# ---------------------------------------------------------------------------
APIFY_TOKEN=
# ~US$ 1,50 por 1.000 posts, cobrança por resultado
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
# ~US$ 0,002 por requisição, independente do número de resultados
APIFY_ACTOR_TIKTOK=scraptik/tiktok-api
# true = loga o que seria raspado sem chamar a Apify nem gastar crédito
SOCIAL_DRY_RUN=true

# ---------------------------------------------------------------------------
# Cadência
# ---------------------------------------------------------------------------
RSS_INTERVALO_MIN=5
# 1 hora é decisão de custo, não limitação técnica.
SOCIAL_INTERVALO_MIN=60
SOCIAL_POSTS_POR_PERFIL=3
DISPATCH_INTERVALO_MIN=2

# ---------------------------------------------------------------------------
# Controles de ruído
# FASE DE CALIBRAGEM: todos desligados de propósito. O sistema manda tudo para
# descobrirmos onde o corte deve ficar. O código existe e é testado — ligar é
# trocar false por true aqui, sem tocar em código.
# ---------------------------------------------------------------------------
FILTRO_SCORE_ATIVO=false
TETO_DIARIO_ATIVO=false
JANELA_SILENCIO_ATIVA=false
COOLDOWN_TEMA_ATIVO=false
COOLDOWN_TEMA_HORAS=12

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3000
TZ=America/Sao_Paulo
# debug | info | warn | error
LOG_LEVEL=info
# false = na 1ª coleta de uma fonte nova, o histórico do feed entra como visto
# mas não é entregue. Evita despejar 40 mensagens no primeiro boot.
BACKFILL_PRIMEIRA_COLETA=false

# Itens avaliados pelo scorer por rodada (segura o gasto num lote grande).
PROCESS_LOTE_MAX=25
# Mensagens enviadas por rodada de dispatch.
DISPATCH_LOTE_MAX=10
# Item mais velho que isso não vira delivery — novidade velha não é novidade.
ITEM_VALIDADE_HORAS=48
# Buscar o corpo do artigo quando o feed só entrega um resumo curto.
RSS_BUSCAR_CORPO=true
