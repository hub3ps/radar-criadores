{
  "name": "radar-criadores",
  "version": "0.1.0",
  "private": true,
  "description": "Agente que monitora fontes de noticias e perfis sociais e alerta criadoras no WhatsApp com resumo e gancho de video.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "job": "tsx src/cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
